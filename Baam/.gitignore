# ---------------------------------------------
# Unreal Engine
# ---------------------------------------------

# Build output
Binaries/
Plugins/*/Binaries/
Build/
!Build/*/
!Build/**/*.ico
!Build/*/PakBlacklist*.txt

# Intermediate / generated files
Intermediate/
Plugins/*/Intermediate/

# Editor cache
DerivedDataCache/

# Editor-generated config, logs, autosaves, crash dumps
Saved/

# Built lighting / navmesh data for maps
*_BuiltData.uasset

# Per-user developer content folders
Content/Developers/

# ---------------------------------------------
# Project files generated by UnrealBuildTool
# ---------------------------------------------
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# ---------------------------------------------
# IDE / editor local state
# ---------------------------------------------
.vs/
.idea/
.vscode/

# ---------------------------------------------
# Compiled binaries & libraries
# ---------------------------------------------
*.obj
*.o
*.lo
*.slo
*.pch
*.gch
*.dll
*.so
*.dylib
*.lib
*.a
*.la
*.lai
*.exp
*.pdb
*.ilk
*.exe
*.out
*.app
*.ipa

# ---------------------------------------------
# OS cruft
# ---------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
